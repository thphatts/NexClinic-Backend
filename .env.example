# Environment Variables Template
# Copy this file to .env and fill in your actual credentials. DO NOT commit .env to Git!

# PostgreSQL Database Settings
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_DB=my_postgres_db
POSTGRES_PORT=5434

# MySQL Database Settings
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_USER=user
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DATABASE=my_mysql_db
MYSQL_PORT=3309

# Spring Boot Application Database Binding
DB_HOST=localhost
DB_PORT=5434
DB_NAME=my_postgres_db
DB_USERNAME=admin
DB_PASSWORD=your_secure_postgres_password

# Security & JWT Configuration
JWT_SECRET=[REDACTED_SECRET]
JWT_EXPIRATION_MS=86400000

# Redis Settings
REDIS_PORT=6379
