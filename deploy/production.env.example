# Copy to /opt/nexclinic/.env on EC2; do not commit real values.
POSTGRES_DB=nexclinic
POSTGRES_USER=nexclinic
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Generate once: openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=replace-with-base64-secret
JWT_EXPIRATION_MS=86400000
FRONTEND_URL=https://portal.example.com
APP_PORT=8080
ENABLE_SWAGGER=false
GEMINI_API_KEY=
VNPAY_TMN_CODE=replace-with-merchant-code
VNPAY_SECRET_KEY=replace-with-gateway-secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://api.example.com/api/v1/payments/vnpay-return
